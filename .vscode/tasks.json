{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-debug-windows",
			"type": "shell",
			"command": "cmake -S . -B build; cmake --build build --config Debug --target finance_core",
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-debug-linux",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --target finance_core",
			"group": "build",
			"problemMatcher": "$gcc"
		},
		{
			"label": "build-tests-debug-windows",
			"type": "shell",
			"command": "cmake -S . -B build -DBUILD_TESTS=ON; cmake --build build --config Debug --target finance_core_tests",
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-tests-debug-linux",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTS=ON && cmake --build build --target finance_core_tests",
			"group": "build",
			"problemMatcher": "$gcc"
		},
		{
			"label": "build-release-windows",
			"type": "shell",
			"command": "cmake -S . -B build; cmake --build build --config Release --target finance_core",
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-release-linux",
			"type": "shell",
			"command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --target finance_core",
			"group": "build",
			"problemMatcher": "$gcc"
		},
	]
}